# Set these with:  supabase secrets set NAME=value   (never commit real values)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically.

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

WA_ACCESS_TOKEN=        # permanent token from Meta (System User)
WA_PHONE_NUMBER_ID=     # WhatsApp phone number ID (not the phone number itself)
WA_APP_SECRET=          # Meta app secret, used to verify webhook signatures
WA_VERIFY_TOKEN=        # any long random text; paste the same into Meta's webhook setup
CRON_SECRET=            # any long random text; sent by the scheduler to daily-maintenance

# Optional approved WhatsApp templates for messages sent outside the 24-hour window
# WA_ADMIN_TEMPLATE=      # 2 variables: reference, amount
# WA_VERIFIED_TEMPLATE=   # 2 variables: service, reference
# WA_REJECTED_TEMPLATE=   # 1 variable: reference
# WA_EXPIRY_TEMPLATE=     # 2 variables: service, date
# WA_SEAT_TEMPLATE=       # 1 variable: date
